/* Draw Steel Expert - Elegant Chat Styles */

Screen {
    layout: vertical;
}

#chat-view {
    background: $surface;
    height: 1fr;
    padding: 1 2;
}

Input {
    dock: bottom;
    margin: 1 2;
}

UserMessage {
    background: $primary 10%;
    width: auto;
    color: $text;
    margin: 1;
    margin-left: 8;
    padding: 1 2 0 2;
}

AssistantMessage {
    border: wide $success;
    background: $success 10%;
    color: $text;
    margin: 1;
    margin-right: 8;
    padding: 1 2 0 2;
}

SystemMessage {
    background: $warning 10%;
    color: $text;
    margin: 1;
    padding: 1 2 0 2;
    text-style: italic;
}

ToolMessage {
    background: $secondary 10%;
    color: $text-muted;
    margin: 0 1;
    padding: 0 0;
}
.search-collapsible {
    height: auto;
    padding: 0 0 0 0;
    margin: 1 0 0 1;
    border: none;
}

.search-results {
    height: auto;
    padding: 0 0 0 0;
    margin: 1 1 0 1;
}
.chunk-collapsible {
    width: 1fr;
    text-wrap: wrap;
    padding: 0 0 0 0;
    margin: 1 5 0 1;
    border: none;
    height: auto;
    background: $background 50%;

}